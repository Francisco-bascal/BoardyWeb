@model IReadOnlyList<TableroMiembroDto>
@{
    var tableroId = ViewData["TableroId"];
    var roles = ViewData["Roles"] as SelectList;
    var puedeAdministrar = ViewData["PuedeAdministrar"] is true;

    string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "?",
            1 => partes[0][..1],
            _ => partes[0][..1] + partes[^1][..1]
        };
    }
}

<div id="region-miembros" data-region-url="@Url.Action("Index", "Miembros", new { tableroId })">
    <div class="tabla-contenedor">
        <table class="table align-middle">
            <thead>
                <tr><th>Miembro</th><th>Roles</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var miembro in Model)
                {
                    var editable = puedeAdministrar && !miembro.EsPropietario;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-lg">@Iniciales(miembro.NombreCompleto)</span>
                                <div>
                                    <div class="fw-semibold">@miembro.NombreCompleto</div>
                                    <div class="small text-suave">@miembro.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @foreach (var rol in miembro.Roles)
                            {
                                <span class="chip me-1">
                                    @rol.Nombre
                                    @if (editable && miembro.Roles.Count > 1)
                                    {
                                        <button type="button" class="btn-close ms-1" style="font-size: .5rem" aria-label="Quitar rol"
                                                data-accion-url="@Url.Action("QuitarRol", "Miembros", new { tableroId, tableroMiembroId = miembro.TableroMiembroId, rolMiembroId = rol.RolMiembroId })"></button>
                                    }
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            @if (editable)
                            {
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <form asp-action="AsignarRol" asp-route-tableroId="@tableroId" asp-route-tableroMiembroId="@miembro.TableroMiembroId" method="post"
                                          class="d-inline-flex gap-1" data-ajax="true" data-ajax-method="post" data-ajax-success="ajaxFormExito" data-ajax-failure="ajaxFormFallo">
                                        <select name="RolMiembroId" class="form-select form-select-sm" asp-items="roles"></select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Asignar</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-accion-url="@Url.Action("Quitar", "Miembros", new { tableroId, tableroMiembroId = miembro.TableroMiembroId })"
                                            data-confirmar="¿Quitar a @miembro.NombreCompleto del tablero?"><i class="bi bi-person-dash"></i><span class="visually-hidden">Quitar</span></button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
