@using BoardyWeb.Comun
@model Pagina<RegistroAuditoriaDto>
@{
    ViewData["Title"] = "Auditoría";
    var tableroId = ViewData["TableroId"];
    var usuarioId = ViewData["UsuarioId"];
    var miembros = ViewData["Miembros"] as SelectList;
}

<div class="pagina-encabezado">
    <div>
        <a asp-controller="Tableros" asp-action="Detalle" asp-route-id="@tableroId" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i>Volver al tablero</a>
        <h1>Auditoría</h1>
    </div>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="tableroId" value="@tableroId" />
        <select name="usuarioId" class="form-select" aria-label="Filtrar por usuario" asp-items="miembros">
            <option value="">Todos los usuarios</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
    </form>
</div>

@if (!Model.Elementos.Any())
{
    <div class="estado-vacio">
        <i class="bi bi-clock-history"></i>
        <strong>No hay acciones registradas</strong>
    </div>
}
else
{
    <div class="tabla-contenedor">
        <table class="table align-middle">
            <thead>
                <tr><th>Fecha (UTC)</th><th>Usuario</th><th>Acción</th></tr>
            </thead>
            <tbody>
                @foreach (var registro in Model.Elementos)
                {
                    <tr>
                        <td class="text-nowrap">@registro.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@registro.UsuarioNombre</td>
                        <td>@registro.Accion</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <a class="btn btn-outline-secondary@(Model.Numero <= 1 ? " disabled" : "")" asp-route-tableroId="@tableroId" asp-route-usuarioId="@usuarioId" asp-route-pagina="@(Model.Numero - 1)">Anterior</a>
        <span class="small text-suave">Página @Model.Numero de @Model.TotalPaginas</span>
        <a class="btn btn-outline-secondary@(Model.Numero >= Model.TotalPaginas ? " disabled" : "")" asp-route-tableroId="@tableroId" asp-route-usuarioId="@usuarioId" asp-route-pagina="@(Model.Numero + 1)">Siguiente</a>
    </div>
}
