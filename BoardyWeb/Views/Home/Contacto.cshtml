@{
    ViewData["Title"] = "Contacto";
}

<div class="mx-auto" style="max-width: 46rem;">
    <div class="pagina-encabezado">
        <h1>Contacto</h1>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <p class="text-suave">¿Tenés una duda, una sugerencia o encontraste un error? Escribinos.</p>
            <div class="d-flex align-items-center gap-3">
                <span class="caracteristica"><span class="icono"><i class="bi bi-envelope"></i></span></span>
                <div>
                    <div class="small text-suave">Correo electrónico</div>
                    <a class="mono" href="mailto:contacto@boardy.example">contacto@boardy.example</a>
                </div>
            </div>
        </div>
    </div>
</div>
