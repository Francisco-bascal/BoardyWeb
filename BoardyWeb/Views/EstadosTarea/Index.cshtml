@model IReadOnlyList<EstadoTareaDto>
@{
    ViewData["Title"] = "Estados de tarea";
    var tableroId = ViewData["TableroId"];
}

<div class="pagina-encabezado">
    <div>
        <a asp-controller="Tableros" asp-action="Detalle" asp-route-id="@tableroId" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i>Volver al tablero</a>
        <h1>Estados de tarea</h1>
    </div>
    @if (ViewData["PuedeAdministrar"] is true)
    {
        <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Crear", "EstadosTarea", new { tableroId })"><i class="bi bi-plus-lg me-1"></i>Nuevo estado</button>
    }
</div>

<partial name="_Lista" model="Model" />
