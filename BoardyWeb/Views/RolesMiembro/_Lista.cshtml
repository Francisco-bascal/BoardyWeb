@model IReadOnlyList<RolMiembroDto>

<div id="region-roles" data-region-url="@Url.Action("Index", "RolesMiembro")">
    <table class="table align-middle">
        <thead>
            <tr><th>Nombre</th><th>Descripción</th><th class="text-end">Miembros</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol.Nombre</td>
                    <td>@rol.Descripcion</td>
                    <td class="text-end">@rol.CantidadMiembros</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Editar", "RolesMiembro", new { id = rol.RolMiembroId })">Editar</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-accion-url="@Url.Action("Eliminar", "RolesMiembro", new { id = rol.RolMiembroId })"
                                data-confirmar="¿Eliminar el rol @rol.Nombre?">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
