@model IReadOnlyList<RolMiembroDto>

<div id="region-roles" data-region-url="@Url.Action("Index", "RolesMiembro")">
    <div class="tabla-contenedor">
        <table class="table align-middle">
            <thead>
                <tr><th>Nombre</th><th>Descripción</th><th class="text-end">Miembros</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var rol in Model)
                {
                    <tr>
                        <td class="fw-semibold">@rol.Nombre</td>
                        <td class="text-suave">@rol.Descripcion</td>
                        <td class="text-end mono">@rol.CantidadMiembros</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Editar", "RolesMiembro", new { id = rol.RolMiembroId })"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-accion-url="@Url.Action("Eliminar", "RolesMiembro", new { id = rol.RolMiembroId })"
                                    data-confirmar="¿Eliminar el rol @rol.Nombre?"><i class="bi bi-trash"></i><span class="visually-hidden">Eliminar</span></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
