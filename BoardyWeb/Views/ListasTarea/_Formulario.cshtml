@model CrearListaTareaDto
@{
    var editando = ViewData["ListaTareaId"] is not null;
}

<form asp-action="@(editando ? "Editar" : "Crear")" asp-route-id="@ViewData["ListaTareaId"]" asp-route-tableroId="@(editando ? null : ViewData["TableroId"])" method="post"
      data-ajax="true" data-cierra-modal data-ajax-method="post" data-ajax-success="ajaxFormExito" data-ajax-failure="ajaxFormFallo">
    <div class="modal-header">
        <h5 class="modal-title">@(editando ? "Editar lista" : "Nueva lista")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        @if (ViewData["Estados"] is SelectList estados)
        {
            <div class="mb-3">
                <label asp-for="EstadoTareaId" class="form-label"></label>
                <select asp-for="EstadoTareaId" class="form-select" asp-items="estados" required>
                    <option value="">Seleccioná un estado</option>
                </select>
                <span asp-validation-for="EstadoTareaId" class="text-danger"></span>
                <div class="form-text">
                    @(estados.Any() ? "Las tareas de esta lista toman este estado." : "Todos los estados ya tienen su lista. Creá un estado nuevo en Plataforma o editá una lista existente.")
                </div>
            </div>
        }
    </div>
    <div class="modal-footer">
        <a asp-controller="Tableros" asp-action="Detalle" asp-route-id="@ViewData["TableroId"]" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>
