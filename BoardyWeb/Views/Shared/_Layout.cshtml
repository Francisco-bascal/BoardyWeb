@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) ? " active" : "";
    var enAdministracion = controlador is "EstadosTarea" or "RolesMiembro";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Boardy</title>
    @* Fija el tema antes del primer render para evitar el parpadeo. *@
    <script>
        (function () {
            try {
                var tema = localStorage.getItem('boardy-tema');
                if (!tema) {
                    tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', tema);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-boardy">
            <div class="container-xxl">
                <a class="marca" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="marca-logo"><i class="bi bi-kanban-fill"></i></span>
                    <span>Boardy</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto mt-2 mt-md-0 ms-md-3 gap-md-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link@(Activo("Tableros"))" asp-area="" asp-controller="Tableros" asp-action="Index"><i class="bi bi-columns-gap me-1"></i>Tableros</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link@(Activo("Invitaciones"))" asp-area="" asp-controller="Invitaciones" asp-action="Index"><i class="bi bi-envelope me-1"></i>Invitaciones</a>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle@(enAdministracion ? " active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear me-1"></i>Administración</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="EstadosTarea" asp-action="Index">Estados de tarea</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="RolesMiembro" asp-action="Index">Roles de miembro</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                        <button type="button" id="botonTema" class="btn btn-outline-secondary boton-tema" aria-label="Cambiar entre modo diurno y nocturno" title="Cambiar tema">
                            <i class="bi bi-moon-stars icono-luna"></i>
                            <i class="bi bi-sun icono-sol"></i>
                        </button>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-xxl py-4 flex-grow-1">
        <partial name="_Notificaciones" />
        @RenderBody()
    </main>

    <footer class="pie mt-auto">
        <div class="container-xxl py-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="marca-logo"><i class="bi bi-kanban-fill"></i></span>
                <div>
                    <strong class="text-body">Boardy</strong>
                    <div class="small">Tableros de tareas para equipos de desarrollo.</div>
                </div>
            </div>
            <nav class="d-flex flex-wrap gap-3" aria-label="Enlaces del pie">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                <a asp-area="" asp-controller="Home" asp-action="Contacto">Contacto</a>
            </nav>
            <div class="small">&copy; @DateTime.Now.Year Boardy</div>
        </div>
    </footer>

    @* Token antiforgery que usa ajax-crud.js en las acciones POST por AJAX. *@
    <form id="antiforgeryToken" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="modal fade" id="modalGlobal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content"></div>
        </div>
    </div>

    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalConfirmarMensaje"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="modalConfirmarAceptar">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="contenedorToasts"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/localization/messages_es.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ajax-crud.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
