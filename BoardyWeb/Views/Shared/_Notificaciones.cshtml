@* Mensajes de TempData tras una redirección (navegación sin AJAX). *@
@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" data-notificacion="exito">
        @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-notificacion="error">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
