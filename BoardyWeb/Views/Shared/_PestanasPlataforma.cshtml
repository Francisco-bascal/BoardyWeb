@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activa(bool activa) => activa ? " active" : "";
}

<ul class="nav nav-pills mb-4 gap-1">
    <li class="nav-item"><a class="nav-link@(Activa(controlador == "Plataforma" && accion != "Logs"))" asp-controller="Plataforma" asp-action="Index"><i class="bi bi-people me-2"></i>Usuarios</a></li>
    <li class="nav-item"><a class="nav-link@(Activa(controlador == "EstadosTarea"))" asp-controller="EstadosTarea" asp-action="Index"><i class="bi bi-circle-half me-2"></i>Estados de tarea</a></li>
    <li class="nav-item"><a class="nav-link@(Activa(controlador == "RolesMiembro"))" asp-controller="RolesMiembro" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Roles de miembro</a></li>
    <li class="nav-item"><a class="nav-link@(Activa(accion == "Logs"))" asp-controller="Plataforma" asp-action="Logs"><i class="bi bi-bug me-2"></i>Logs de error</a></li>
</ul>
