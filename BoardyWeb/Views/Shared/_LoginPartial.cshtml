@using Microsoft.AspNetCore.Identity
@using BoardyWeb.Models

@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var correo = User.Identity?.Name ?? string.Empty;
    var usuario = await UserManager.GetUserAsync(User);
    var nombreCompleto = usuario is null ? correo : usuario.Nombre + " " + usuario.Apellido;

    <div class="dropdown">
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <partial name="_Avatar" model="(nombreCompleto, usuario?.FotoPerfil, string.Empty)" />
            <span class="d-none d-lg-inline small text-truncate" style="max-width: 11rem;">@correo</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header text-truncate" style="max-width: 16rem;">@correo</h6></li>
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-gear me-2"></i>Mi cuenta</a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form class="px-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Login">Ingresar</a>
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
}
