@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="estado-vacio mx-auto" style="max-width: 36rem;">
    <i class="bi bi-exclamation-octagon"></i>
    <h1 class="h4 mb-0">Algo salió mal</h1>
    <p class="mb-0">Ocurrió un error al procesar tu solicitud. Probá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small mb-0">Id. de solicitud: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
