@model TableroKanbanViewModel
@{
    var tablero = Model.Tablero;
    var columnas = Math.Clamp(Model.Listas.Count, 2, 4);

    string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "?",
            1 => partes[0][..1],
            _ => partes[0][..1] + partes[^1][..1]
        };
    }
}

<div id="region-kanban" data-region-url="@Url.Action("Detalle", "Tableros", new { id = tablero.TableroId })">
    <div class="pagina-encabezado">
        <div>
            <h1>@tablero.Nombre</h1>
            @if (!string.IsNullOrWhiteSpace(tablero.Descripcion))
            {
                <p class="text-suave mb-1">@tablero.Descripcion</p>
            }
            <div class="d-flex flex-wrap gap-2 mt-1">
                <span class="chip"><i class="bi bi-person"></i> @tablero.PropietarioNombre</span>
                <span class="chip"><i class="bi bi-columns-gap"></i> @Model.Listas.Count @(Model.Listas.Count == 1 ? "lista" : "listas")</span>
                <span class="chip"><i class="bi bi-check2-square"></i> @Model.Tareas.Count @(Model.Tareas.Count == 1 ? "tarea" : "tareas")</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Miembros" asp-action="Index" asp-route-tableroId="@tablero.TableroId" class="btn btn-outline-secondary"><i class="bi bi-people me-1"></i>Miembros</a>
            <a asp-controller="Etiquetas" asp-action="Index" asp-route-tableroId="@tablero.TableroId" class="btn btn-outline-secondary"><i class="bi bi-tags me-1"></i>Etiquetas</a>
            @if (Model.PuedeAdministrar)
            {
                <a asp-controller="Invitaciones" asp-action="DelTablero" asp-route-tableroId="@tablero.TableroId" class="btn btn-outline-secondary"><i class="bi bi-envelope-plus me-1"></i>Invitaciones</a>
                <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Crear", "ListasTarea", new { tableroId = tablero.TableroId })"><i class="bi bi-plus-lg me-1"></i>Nueva lista</button>
            }
            @if (Model.PuedeAdministrar)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opciones del tablero"><i class="bi bi-three-dots"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button type="button" class="dropdown-item" data-modal-url="@Url.Action("Editar", "Tableros", new { id = tablero.TableroId })"><i class="bi bi-pencil me-2"></i>Editar tablero</button></li>
                        @if (Model.PuedeGestionar)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <button type="button" class="dropdown-item text-danger" data-accion-url="@Url.Action("Eliminar", "Tableros", new { id = tablero.TableroId })"
                                        data-confirmar="¿Eliminar el tablero y todo su contenido? Esta acción no se puede deshacer."
                                        data-redirigir="@Url.Action("Index", "Tableros")"><i class="bi bi-trash me-2"></i>Eliminar tablero</button>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    @if (!Model.Listas.Any())
    {
        <div class="estado-vacio mb-3">
            <i class="bi bi-columns-gap"></i>
            <strong>Este tablero todavía no tiene listas</strong>
            <span>Creá la primera lista (por ejemplo "Pendiente") para empezar a cargar tareas.</span>
        </div>
    }

    <div class="kanban" style="--kanban-n: @columnas"
         data-puede-colaborar="@(Model.PuedeColaborar ? "true" : "false")" data-puede-administrar="@(Model.PuedeAdministrar ? "true" : "false")">
        @for (var i = 0; i < Model.Listas.Count; i++)
        {
            var lista = Model.Listas[i];
            var tareas = Model.Tareas.Where(t => t.ListaTareaId == lista.ListaTareaId).OrderBy(t => t.Orden).ToList();

            <div class="kanban-columna" data-url-reordenar="@Url.Action("Reordenar", "ListasTarea", new { id = lista.ListaTareaId })">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="kanban-columna-titulo">
                        @if (Model.PuedeAdministrar)
                        {
                            <span class="kanban-columna-asa" title="Arrastrar para reordenar la lista"><i class="bi bi-grip-vertical"></i></span>
                        }
                        <span class="text-truncate">@lista.Nombre</span>
                        <span class="chip">@tareas.Count</span>
                    </div>
                    @if (Model.PuedeAdministrar)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Opciones de la lista"><i class="bi bi-three-dots"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button type="button" class="dropdown-item" data-modal-url="@Url.Action("Editar", "ListasTarea", new { id = lista.ListaTareaId })"><i class="bi bi-pencil me-2"></i>Editar lista</button></li>
                                @if (i > 0)
                                {
                                    <li><button type="button" class="dropdown-item" data-accion-url="@Url.Action("Reordenar", "ListasTarea", new { id = lista.ListaTareaId, NuevoOrden = lista.Orden - 1 })"><i class="bi bi-arrow-left me-2"></i>Mover a la izquierda</button></li>
                                }
                                @if (i < Model.Listas.Count - 1)
                                {
                                    <li><button type="button" class="dropdown-item" data-accion-url="@Url.Action("Reordenar", "ListasTarea", new { id = lista.ListaTareaId, NuevoOrden = lista.Orden + 1 })"><i class="bi bi-arrow-right me-2"></i>Mover a la derecha</button></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><button type="button" class="dropdown-item text-danger" data-accion-url="@Url.Action("Eliminar", "ListasTarea", new { id = lista.ListaTareaId })" data-confirmar="¿Eliminar la lista @lista.Nombre?"><i class="bi bi-trash me-2"></i>Eliminar lista</button></li>
                            </ul>
                        </div>
                    }
                </div>

                <div class="kanban-tareas" data-lista-id="@lista.ListaTareaId">
                    <div class="kanban-vacio">Sin tareas</div>
                    @foreach (var tarea in tareas)
                    {
                        // Propietario/Administrador mueven cualquier tarea; el Operario solo las que tiene asignadas.
                        var puedeTrabajar = Model.PuedeAdministrar
                            || (Model.PuedeColaborar && tarea.Miembros.Any(m => m.UsuarioId == Model.UsuarioActualId));

                        <div class="tarjeta-tarea kanban-tarjeta@(puedeTrabajar ? "" : " tarjeta-fija") prioridad-@tarea.Prioridad.ToString().ToLowerInvariant()" data-url-mover="@Url.Action("Mover", "Tareas", new { id = tarea.TareaId })">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <a href="#" class="titulo" data-modal-url="@Url.Action("Detalle", "Tareas", new { id = tarea.TareaId })">@tarea.Titulo</a>
                                <span class="chip chip-prioridad">@tarea.Prioridad</span>
                            </div>

                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <span class="chip"><i class="bi bi-circle-half"></i> @tarea.EstadoNombre</span>
                                <partial name="_ChipVencimiento" model="tarea" />
                            </div>

                            @if (tarea.Etiquetas.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach (var etiqueta in tarea.Etiquetas)
                                    {
                                        <span class="etiqueta-pill" style="background-color: @etiqueta.Color">@etiqueta.Nombre</span>
                                    }
                                </div>
                            }

                            @if (tarea.Miembros.Any() || (puedeTrabajar && Model.Listas.Count > 1))
                            {
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div class="avatares">
                                        @foreach (var miembro in tarea.Miembros)
                                        {
                                            <span class="avatar" title="@miembro.NombreCompleto">@Iniciales(miembro.NombreCompleto)</span>
                                        }
                                    </div>
                                    @if (puedeTrabajar && Model.Listas.Count > 1)
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-link p-0 text-suave text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-arrow-left-right me-1"></i>Mover</button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var destino in Model.Listas.Where(l => l.ListaTareaId != lista.ListaTareaId))
                                                {
                                                    <li><button type="button" class="dropdown-item" data-accion-url="@Url.Action("Mover", "Tareas", new { id = tarea.TareaId, ListaTareaId = destino.ListaTareaId })">@destino.Nombre</button></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (Model.PuedeAdministrar)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-2" data-modal-url="@Url.Action("Crear", "Tareas", new { listaTareaId = lista.ListaTareaId })"><i class="bi bi-plus-lg me-1"></i>Agregar tarea</button>
                }
            </div>
        }
    </div>
</div>
