@model IReadOnlyList<InvitacionTableroDto>

<div id="region-invitaciones" data-region-url="@Url.Action("Index", "Invitaciones")">
    @if (!Model.Any())
    {
        <div class="estado-vacio">
            <i class="bi bi-envelope-open"></i>
            <strong>No tenés invitaciones pendientes</strong>
            <span>Cuando alguien te invite a un tablero, lo vas a ver acá.</span>
        </div>
    }
    <div class="d-grid gap-2">
        @foreach (var invitacion in Model)
        {
            <div class="card card-interactiva">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="fw-semibold"><i class="bi bi-kanban me-1 text-suave"></i>@invitacion.TableroNombre</div>
                        <div class="small text-suave">
                            Te invitó @invitacion.UsuarioInvitadorNombre el @invitacion.FechaInvitacion.ToString("dd/MM/yyyy")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(invitacion.Mensaje))
                        {
                            <div class="mt-1">&ldquo;@invitacion.Mensaje&rdquo;</div>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" data-accion-url="@Url.Action("Aceptar", "Invitaciones", new { id = invitacion.InvitacionTableroId })"><i class="bi bi-check-lg me-1"></i>Aceptar</button>
                        <button type="button" class="btn btn-outline-danger" data-accion-url="@Url.Action("Rechazar", "Invitaciones", new { id = invitacion.InvitacionTableroId })"
                                data-confirmar="¿Rechazar la invitación a @invitacion.TableroNombre?">Rechazar</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
