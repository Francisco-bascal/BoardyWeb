@model IReadOnlyList<InvitacionTableroDto>
@{
    ViewData["Title"] = "Invitaciones del tablero";
    var tableroId = ViewData["TableroId"];
}

<div class="pagina-encabezado">
    <div>
        <a asp-controller="Tableros" asp-action="Detalle" asp-route-id="@tableroId" class="small"><i class="bi bi-arrow-left me-1"></i>Volver al tablero</a>
        <h1>Invitaciones enviadas</h1>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Crear" asp-route-tableroId="@tableroId" method="post" class="row g-2 align-items-center"
              data-ajax="true" data-ajax-method="post" data-ajax-success="ajaxFormExito" data-ajax-failure="ajaxFormFallo">
            <div class="col-md-4">
                <input name="Email" type="email" class="form-control" placeholder="Correo del usuario" required />
            </div>
            <div class="col-md-5">
                <input name="Mensaje" class="form-control" placeholder="Mensaje (opcional)" maxlength="1000" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>Invitar</button>
            </div>
        </form>
    </div>
</div>

<partial name="_ListaEnviadas" model="Model" />
