@model IReadOnlyList<EtiquetaDto>
@{
    ViewData["Title"] = "Etiquetas";
    var tableroId = ViewData["TableroId"];
}

<div class="pagina-encabezado">
    <div>
        <a asp-controller="Tableros" asp-action="Detalle" asp-route-id="@tableroId" class="small"><i class="bi bi-arrow-left me-1"></i>Volver al tablero</a>
        <h1>Etiquetas</h1>
    </div>
    @if (ViewData["PuedeAdministrar"] is true)
    {
        <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Crear", "Etiquetas", new { tableroId })"><i class="bi bi-plus-lg me-1"></i>Nueva etiqueta</button>
    }
</div>

<partial name="_Lista" model="Model" />
