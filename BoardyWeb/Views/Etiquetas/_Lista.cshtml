@model IReadOnlyList<EtiquetaDto>
@{
    var puedeAdministrar = ViewData["PuedeAdministrar"] is true;
}

<div id="region-etiquetas" data-region-url="@Url.Action("Index", "Etiquetas", new { tableroId = ViewData["TableroId"] })">
    @if (!Model.Any())
    {
        <p class="text-muted">Este tablero todavía no tiene etiquetas.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Etiqueta</th><th>Descripción</th><th class="text-end">Tareas</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var etiqueta in Model)
                {
                    <tr>
                        <td><span class="badge" style="background-color: @etiqueta.Color">@etiqueta.Nombre</span></td>
                        <td>@etiqueta.Descripcion</td>
                        <td class="text-end">@etiqueta.CantidadTareas</td>
                        <td class="text-end">
                            @if (puedeAdministrar)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Editar", "Etiquetas", new { id = etiqueta.EtiquetaId })">Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-accion-url="@Url.Action("Eliminar", "Etiquetas", new { id = etiqueta.EtiquetaId })"
                                        data-confirmar="¿Eliminar la etiqueta @etiqueta.Nombre?">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
