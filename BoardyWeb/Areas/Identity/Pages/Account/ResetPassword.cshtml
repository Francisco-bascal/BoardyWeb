@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <h1>Restablecer contraseña</h1>
        <p class="text-suave">Elegí una nueva contraseña para tu cuenta.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Nueva contraseña</label>
                <div class="campo-icono">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="btn btn-sm btn-link btn-ojo" data-alternar-clave aria-label="Mostrar u ocultar la contraseña"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Restablecer contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
