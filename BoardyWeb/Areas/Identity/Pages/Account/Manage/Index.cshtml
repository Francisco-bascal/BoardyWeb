@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h5 mb-3">Perfil</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <partial name="_Avatar" model='(Model.NombreCompleto, Model.FotoPerfil, "avatar-perfil")' />
    <form method="post" enctype="multipart/form-data" asp-page-handler="Foto" class="d-flex flex-wrap gap-2">
        <input type="file" name="foto" class="form-control" accept="image/jpeg,image/png,image/webp" aria-label="Foto de perfil" required style="max-width: 18rem;" />
        <button type="submit" class="btn btn-outline-primary">Subir foto</button>
    </form>
    @if (Model.FotoPerfil is not null)
    {
        <form method="post" asp-page-handler="QuitarFoto">
            <button type="submit" class="btn btn-outline-danger">Quitar</button>
        </form>
    }
    <div class="form-text w-100 mt-0">JPG, PNG o WebP, hasta 2 MB.</div>
</div>

<form id="profile-form" method="post" style="max-width: 28rem;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Usuario</label>
        <input asp-for="Username" class="form-control" disabled />
    </div>
    <div class="mb-4">
        <label asp-for="Input.PhoneNumber" class="form-label"></label>
        <input asp-for="Input.PhoneNumber" class="form-control" />
        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
    </div>
    <button id="update-profile-button" type="submit" class="btn btn-primary">Guardar cambios</button>
</form>

<hr class="my-4" />
<h2 class="h5 text-danger">Eliminar mi cuenta</h2>
<p class="text-suave">Perdés el acceso y dejás todos tus tableros. Tus comentarios y acciones quedan como "Usuario eliminado". No se puede deshacer, y no podés hacerlo si sos propietario de algún tablero.</p>
<form method="post" asp-page-handler="EliminarCuenta" style="max-width: 28rem;">
    <div class="mb-3">
        <label for="claveEliminar" class="form-label">Contraseña actual</label>
        <input id="claveEliminar" name="clave" type="password" class="form-control" autocomplete="current-password" required />
    </div>
    <div class="form-check mb-3">
        <input id="confirmaEliminar" type="checkbox" class="form-check-input" required />
        <label for="confirmaEliminar" class="form-check-label">Entiendo que no se puede deshacer.</label>
    </div>
    <button type="submit" class="btn btn-outline-danger">Eliminar mi cuenta</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
