@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <div class="estado-vacio border-0 p-0">
            <i class="bi bi-shield-lock"></i>
            <h1 class="h4 mb-0">Acceso denegado</h1>
            <p class="mb-0">No tenés permiso para acceder a este recurso.</p>
            <a class="btn btn-primary mt-2" asp-area="" asp-controller="Tableros" asp-action="Index">Ir a mis tableros</a>
        </div>
    </div>
</div>
