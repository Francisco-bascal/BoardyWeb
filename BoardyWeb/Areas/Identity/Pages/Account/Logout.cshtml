@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <div class="estado-vacio border-0 p-0">
            <i class="bi bi-box-arrow-right"></i>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <h1 class="h4 mb-0">¿Cerrar sesión?</h1>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-primary mt-2">Cerrar sesión</button>
                </form>
            }
            else
            {
                <h1 class="h4 mb-0">Sesión cerrada</h1>
                <p class="mb-0">Cerraste sesión correctamente.</p>
                <a class="btn btn-primary mt-2" asp-page="./Login">Ingresar</a>
            }
        </div>
    </div>
</div>
