@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Revisá tu correo";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <div class="estado-vacio border-0 p-0">
            <i class="bi bi-envelope-check"></i>
            <h1 class="h4 mb-0">Revisá tu correo</h1>
            <p class="mb-0">Si existe una cuenta con ese correo, te enviamos un enlace para restablecer la contraseña.</p>
            <a class="btn btn-primary mt-2" asp-page="./Login">Volver a ingresar</a>
        </div>
    </div>
</div>
