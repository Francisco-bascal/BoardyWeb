@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-shell">
    <partial name="_PanelAuth" />

    <div class="auth-form">
        <h1>Crear cuenta</h1>
        <p class="text-suave">Empezá a organizar tus proyectos en minutos.</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Input.Nombre" class="form-label"></label>
                    <input asp-for="Input.Nombre" class="form-control" autocomplete="given-name" aria-required="true" />
                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Input.Apellido" class="form-label"></label>
                    <input asp-for="Input.Apellido" class="form-control" autocomplete="family-name" aria-required="true" />
                    <span asp-validation-for="Input.Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="btn btn-sm btn-link btn-ojo" data-alternar-clave aria-label="Mostrar u ocultar la contraseña"><i class="bi bi-eye"></i></button>
                </div>
                <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg w-100">Crear cuenta</button>
        </form>

        <hr class="my-4" />
        <p class="mb-0">¿Ya tenés cuenta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Ingresá</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
