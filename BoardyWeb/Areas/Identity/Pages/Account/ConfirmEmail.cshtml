@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmar correo electrónico";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <div class="estado-vacio border-0 p-0">
            <i class="bi bi-patch-check"></i>
            <h1 class="h4 mb-0">Confirmación de correo</h1>
            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <p class="mb-0">@Model.StatusMessage</p>
            }
            <a class="btn btn-primary mt-2" asp-area="Identity" asp-page="/Account/Login">Ir a ingresar</a>
        </div>
    </div>
</div>
