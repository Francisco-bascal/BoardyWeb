@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <div class="estado-vacio border-0 p-0">
            <i class="bi bi-check-circle"></i>
            <h1 class="h4 mb-0">Contraseña restablecida</h1>
            <p class="mb-0">Ya podés ingresar con tu nueva contraseña.</p>
            <a class="btn btn-primary mt-2" asp-page="./Login">Ingresar</a>
        </div>
    </div>
</div>
