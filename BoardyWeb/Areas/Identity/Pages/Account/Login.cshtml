@page
@model LoginModel

@{
    ViewData["Title"] = "Ingresar";
}

<div class="auth-shell">
    <partial name="_PanelAuth" />

    <div class="auth-form">
        <h1>Ingresar</h1>
        <p class="text-suave">Entrá a tu cuenta para ver tus tableros.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <a id="forgot-password" class="small" asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                </div>
                <div class="campo-icono">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Tu contraseña" />
                    <button type="button" class="btn btn-sm btn-link btn-ojo" data-alternar-clave aria-label="Mostrar u ocultar la contraseña"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe"></label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
        </form>

        <hr class="my-4" />
        <p class="mb-1">¿No tenés cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Creá una</a></p>
        <p class="mb-0"><a id="resend-confirmation" class="small" asp-page="./ResendEmailConfirmation">Reenviar correo de confirmación</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
