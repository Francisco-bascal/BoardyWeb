@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-shell auth-shell-simple">
    <div class="auth-form">
        <h1>Recuperar contraseña</h1>
        <p class="text-suave">Ingresá tu correo y te enviaremos un enlace para restablecerla.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="campo-icono">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Enviar enlace</button>
        </form>
        <p class="mt-4 mb-0"><a asp-page="./Login">Volver a ingresar</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
